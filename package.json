{
  "name": "life-tracker-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "codegen": "openapi-ts",
    "dev": "npm run codegen && vite",
    "build": "npm run codegen && tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
